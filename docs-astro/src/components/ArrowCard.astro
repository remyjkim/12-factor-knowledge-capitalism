---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const factor = entry.data.factor ?? parseInt(entry.slug.split("-")[0], 10);
const factorLabel = Number.isFinite(factor) ? String(factor).padStart(2, "0") : null;
---

<a href={`/${entry.collection}/${entry.slug}`} class="relative group flex flex-nowrap items-start gap-3 py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
  {factorLabel && (
    <div class="font-mono text-xs pt-1 text-black/35 dark:text-white/35 group-hover:text-black/60 dark:group-hover:text-white/60 transition-colors duration-300">
      {factorLabel}
    </div>
  )}
  <div class="flex flex-col flex-1 truncate">
    <div class="font-semibold">
      {entry.data.title}
    </div>
    <div class="text-sm">
      {entry.data.description}
    </div>
  </div>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
    <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
  </svg>
</a>
